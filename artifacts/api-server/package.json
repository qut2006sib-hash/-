{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "accounts:setup": "tsx src/scripts/setup-accounts.ts",
    "accounts:setup:demo": "tsx src/scripts/setup-accounts.ts --demo",
    "demo:prepare": "tsx src/scripts/demo.ts",
    "demo:base": "tsx src/scripts/demo.ts --base-only",
    "demo:reset": "tsx src/scripts/demo.ts --reset",
    "test": "tsx tests/run.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^5.0.5"
  }
}
